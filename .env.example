# Public OAuth client IDs. These are baked into the Electron main bundle at
# build time — never put a client secret here.

# Sign in with Vercel app, authentication type "none", callback:
# http://127.0.0.1:17342/oauth/callback
VERCEL_OAUTH_CLIENT_ID=

# Cloudflare OAuth client, token auth method "none", same callback URI.
CLOUDFLARE_OAUTH_CLIENT_ID=

# Optional exact scope list. Cloudflare does not infer the client's registered
# scopes when this authorization request omits `scope`; DeployDeck otherwise
# reuses saved scopes or preflights its known scope ids. Every id supplied here
# must already be enabled on the OAuth client.
# Include offline_access when the client enables the refresh_token grant.
# CLOUDFLARE_OAUTH_SCOPES=account-settings.read workers-scripts.edit workers-routes.write workers-tail.read zone.read dns.write offline_access
